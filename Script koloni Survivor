local function Notify(title, text)
    local NotificationGui = Instance.new("ScreenGui", LP.PlayerGui)
    local Frame = Instance.new("Frame", NotificationGui)
    Frame.Size = UDim2.new(0, 250, 0, 80)
    Frame.Position = UDim2.new(1, 0, 0.8, 0)
    Frame.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
    Instance.new("UICorner", Frame)
    
    local T = Instance.new("TextLabel", Frame)
    T.Size = UDim2.new(1, 0, 0.4, 0)
    T.Text = title; T.TextColor3 = Color3.new(1, 1, 1); T.BackgroundTransparency = 1; T.Font = "GothamBold"
    
    local C = Instance.new("TextLabel", Frame)
    C.Size = UDim2.new(1, 0, 0.6, 0); C.Position = UDim2.new(0, 0, 0.4, 0)
    C.Text = text; C.TextColor3 = Color3.new(0.8, 0.8, 0.8); C.BackgroundTransparency = 1; C.Font = "Gotham"
    
    Frame:TweenPosition(UDim2.new(0.8, 0, 0.8, 0), "Out", "Quart", 0.5)
    task.delay(3, function()
        Frame:TweenPosition(UDim2.new(1, 0, 0.8, 0), "In", "Quart", 0.5)
        task.wait(0.5); NotificationGui:Destroy()
    end)
end

