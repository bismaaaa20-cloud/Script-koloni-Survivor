task.spawn(function()
    while task.wait(0.1) do
        if getgenv().FarmAktif and getgenv().Config.KillAll and LocalPlayer.Character then
            local myRoot = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if myRoot then
                for _, v in ipairs(workspace:GetDescendants()) do
                    if v:IsA("Humanoid") and v.Parent ~= LocalPlayer.Character and not Players:GetPlayerFromCharacter(v.Parent) then
                        local enemyRoot = v.Parent:FindFirstChild("HumanoidRootPart")
                        if enemyRoot and (myRoot.Position - enemyRoot.Position).Magnitude <= getgenv().Config.KillRadius then
                            if v.Health > 0 then
                                v.Health = 0
                                pcall(function()
                                    local remote = ReplicatedStorage:FindFirstChild("Attack") or ReplicatedStorage:FindFirstChild("Hit")
                                    if remote then remote:FireServer(v, getgenv().Config.Damage) end
                                end)
                            end
                        end
                    end
                end
            end
        end
    end
end)

