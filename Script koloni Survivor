local function AktifkanGodMode(char)
    local hum = char:WaitForChild("Humanoid")
    RunService.RenderStepped:Connect(function()
        if getgenv().FarmAktif and getgenv().Config.GodModeAktif and hum.Health < hum.MaxHealth then
            hum.Health = hum.MaxHealth
        end
    end)
    hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
end
if LocalPlayer.Character then AktifkanGodMode(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(AktifkanGodMode)

